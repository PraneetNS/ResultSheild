# Environment variables for API Gateway
NODE_ENV=production
PORT=3000

# Redis
REDIS_URL=redis://redis-primary:6379

# Service URLs
RESULT_SERVICE_URL=http://result-service-1:8000
WAITING_ROOM_URL=http://waiting-room:8001

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_BURST=20

# Circuit Breaker
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30

# Logging
LOG_LEVEL=info

# CORS
ALLOWED_ORIGINS=*
# Adaptive Rate Limiting (Phase 7)
ENABLE_ADAPTIVE_LIMITING=true
STABILITY_WINDOW=300000
RISK_THRESHOLD=70
